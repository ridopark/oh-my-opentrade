# Binaries — every backend/omo-* file at the backend root is a
# compiled Go entrypoint produced by `go build ./cmd/<name>`
backend/bin/
backend/omo-*

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Node (dashboard)
apps/dashboard/node_modules/
apps/dashboard/.next/

# Docker
*.log

# Runtime logs
logs/

# Temp
tmp/

# Debug screenshots
/*.png

# Playwright MCP artifacts (local tool output — screenshots, snapshots, console logs)
.playwright-mcp/

# Backtest result dumps (ephemeral, regenerated per run; 14 historical
# baselines are grandfathered as tracked files and stay unaffected)
_workspace/*.json

# Agent-pipeline mailbox files — written by one agent, consumed by the
# next, regenerated per run (see .claude/agents/ops-* and strategy-tuning)
_workspace/incident_report.md
_workspace/fix_plan.md
_workspace/review_verdict.md

# Harness-generated lock files
.claude/scheduled_tasks.lock
