# Source Discord channel to scrape (full URL including guild + channel IDs)
DISCORD_CHANNEL_URL=https://discord.com/channels/XXXX/YYYY

# omo-core backend endpoint (host, since we use network_mode: host)
OMO_BACKEND_URL=http://localhost:8080

# Shared secret for authenticating the sidecar to omo-core.
# Generate with: openssl rand -hex 32
OMO_COPYTRADE_SECRET=

# How often to poll the channel DOM (seconds)
POLL_INTERVAL_SECS=1.0

# Log level: debug | info | warn | error
LOG_LEVEL=info
